{
  "numStartups": 42,
  "theme": "dark",
  "mcpServers": {
    "sentry": { "type": "http", "url": "https://mcp.sentry.dev/mcp" },
    "playwright": { "type": "stdio", "command": "npx", "args": ["@playwright/mcp@latest"], "env": {} }
  },
  "projects": {
    "C:/dev/app": {
      "allowedTools": [],
      "mcpServers": {
        "postgres": { "type": "stdio", "command": "uvx", "args": ["mcp-server-postgres", "postgresql://localhost/app"] }
      },
      "hasTrustDialogAccepted": true
    },
    "C:/dev/other": { "allowedTools": [] }
  }
}
